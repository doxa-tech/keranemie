  "views": {
    "public.player_scores": {
      "columns": {
        "player_id": {
          "name": "player_id",
          "type": "uuid",
          "primaryKey": false,
          "notNull": true
        },
        "party_id": {
          "name": "party_id",
          "type": "uuid",
          "primaryKey": false,
          "notNull": true
        },
        "team_id": {
          "name": "team_id",
          "type": "uuid",
          "primaryKey": false,
          "notNull": true
        },
        "score": {
          "name": "score",
          "type": "integer",
          "primaryKey": false,
          "notNull": true
        }
      },
      "definition": "\n    select\n      p.id as player_id,\n      p.party_id,\n      p.team_id,\n      (\n        coalesce((select sum(s.points_awarded) from submissions s\n                  where s.player_id = p.id and s.status = 'approved'), 0)\n        + coalesce((select sum(b.points) from bonuses b\n                    where b.player_id = p.id), 0)\n      )::int as score\n    from players p\n  ",
      "name": "player_scores",
      "schema": "public",
      "isExisting": false,
      "with": {
        "securityInvoker": true
      },
      "materialized": false
    },
    "public.team_scores": {
      "columns": {
        "team_id": {
          "name": "team_id",
          "type": "uuid",
          "primaryKey": false,
          "notNull": true
        },
        "party_id": {
          "name": "party_id",
          "type": "uuid",
          "primaryKey": false,
          "notNull": true
        },
        "score": {
          "name": "score",
          "type": "integer",
          "primaryKey": false,
          "notNull": true
        }
      },
      "definition": "\n    select\n      t.id as team_id,\n      t.party_id,\n      (\n        coalesce((select sum(ps.score) from player_scores ps\n                  where ps.team_id = t.id), 0)\n        + coalesce((select sum(b.points) from bonuses b\n                    where b.team_id = t.id), 0)\n      )::int as score\n    from teams t\n  ",
      "name": "team_scores",
      "schema": "public",
      "isExisting": false,
      "with": {
        "securityInvoker": true
      },
      "materialized": false
    }
  },
