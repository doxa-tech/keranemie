# Local values: run `npm run supabase:start`, then `npx supabase status`
# for the publishable and secret keys.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres
# Public URL of the app, used in join links and QR codes.
APP_URL=http://localhost:3000
# Shared secret for the scheduled job endpoint. Locally it must match
# supabase/seed.sql; elsewhere use a random value (`openssl rand -hex 24`).
CRON_SECRET=local-dev-cron-secret
# Password needed to create a new admin account (invited admins don't
# need it). Locally it must match e2e/helpers.ts; elsewhere choose your own.
ADMIN_SIGNUP_PASSWORD=local-dev-admin-password
# Web push keys: `npx web-push generate-vapid-keys`.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@keranemie.local
